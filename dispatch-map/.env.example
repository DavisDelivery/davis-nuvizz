# Firebase (client-side — reuse the davismarginiq project config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=davismarginiq.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=davismarginiq
VITE_FIREBASE_STORAGE_BUCKET=davismarginiq.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API key (client-side — restrict by HTTP referrer in GCP console)
VITE_GOOGLE_MAPS_API_KEY=

# Mock-mode toggle — when true the app loads /test/fixtures/nuvizz-today-stops.json
# instead of calling the Netlify function. Useful for local dev without NuVizz creds.
VITE_USE_MOCK_NUVIZZ=false

# --- Server-side (Netlify Functions only — never prefix VITE_) ---
NUVIZZ_DAVIS_COMPANY_CODE=DAVIS
NUVIZZ_DAVIS_USER=
NUVIZZ_DAVIS_PASS=
NUVIZZ_BASE_URL=https://portal.nuvizz.com/deliverit/openapi/v7

# --- Live-write (BETA) — server-side kill switch for the nuvizz-write endpoint ---
# Master gate for REAL NuVizz writes (driver assign / dispatch / plan / unplan / create).
# Default OFF: with this unset/!=true, every mutating op returns 403 and NOTHING is sent
# to NuVizz — the UI's Beta/Live toggle still previews (dry-run) but cannot commit. Set to
# 'true' ONLY after confirming NUVIZZ_DAVIS_USER above is permitted to assign/dispatch in
# NuVizz (not just read). Reuses the read creds + base URL above.
NUVIZZ_WRITE_ENABLED=false

# Client-side opt-in to SHOW the live-dispatch UI in the Compare panel (default hidden).
# Showing the UI does NOT enable writes (that's NUVIZZ_WRITE_ENABLED above); it only
# surfaces the driver picker / Save / Beta-Live toggle. Per-session override: ?write=1.
VITE_NUVIZZ_WRITE_BETA=false

# Motive API (server-side only)
MOTIVE_API_KEY=__REDACTED__
MOTIVE_BASE_URL=https://api.gomotive.com/v1

# Anthropic API key — powers M6 AI Order Search (ai-search function) and the
# routing brain (anthropic-routing). Server-side only; NEVER prefix with VITE_.
# Optional model overrides: ANTHROPIC_PARSE_MODEL, ANTHROPIC_CHAT_MODEL.
ANTHROPIC_API_KEY=

# --- Gmail: read the nightly Uline freight report out of a Google mailbox ---
# The scheduled manifest check (manifest-email-ingest-background) polls every
# mailbox that is configured. Set ALL THREE of these to switch Gmail on; leave any
# of them blank and the Gmail half no-ops silently (Resend, below, is unaffected).
#
# ⚠ READ THIS FIRST — THE 7-DAY TRAP. An External OAuth app whose publishing
# status is still "Testing" is issued refresh tokens that expire after 7 DAYS.
# The check would work for a week, then quietly stop with invalid_grant. So the
# consent screen MUST be either:
#   • User type INTERNAL — if the mailbox is a Google Workspace account on our own
#     domain. No verification, no expiry, nothing to publish. Do this if you can.
#   • or External with publishing status IN PRODUCTION — needed for an @gmail.com
#     mailbox, since Internal is not offered there. Publish it; you can ignore the
#     "unverified app" warning for our own single account.
# Leaving it External + Testing is the one configuration that looks fine on day
# one and is broken by the following Monday.
#
# ONE-TIME SETUP:
#   1. GCP console > APIs & Services > enable the Gmail API on the project.
#   2. OAuth consent screen > set User type / publishing status per the note above.
#   3. Credentials > Create > OAuth client ID > WEB APPLICATION, with the
#      authorized redirect URI https://developers.google.com/oauthplayground
#      (Desktop app no longer works — Google killed the out-of-band flow in 2022).
#   4. Mint a refresh token once at https://developers.google.com/oauthplayground:
#      gear icon > "Use your own OAuth credentials" > paste the client id/secret,
#      Access type OFFLINE, tick "Force prompt consent screen"; scope
#      https://www.googleapis.com/auth/gmail.readonly; Authorize, SIGNED IN AS THE
#      MAILBOX THAT RECEIVES THE REPORT; then "Exchange authorization code for
#      tokens" and copy the refresh token.
#   5. Put the three values here / in the Netlify env. Read-only scope: the app
#      never sends, labels, or deletes.
# Google also drops a refresh token that has gone 6 months unused, and on a
# password change. When it does expire the job logs "gmail auth failed:
# invalid_grant" and keeps reading the other mailbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# ── v0.54.75: steps 3-5 above are now OPTIONAL ───────────────────────────────
# With CLIENT_ID + CLIENT_SECRET set, "Connect Gmail" on the Manifest check tab
# does the consent round-trip in the app and seals the refresh token in Firestore
# (AES-256-GCM, server-only key) — no playground, and RECONNECTING after the
# 7-day expiry above is one click instead of a re-mint. Register this site's
# https://<site>/.netlify/functions/gmail-auth as an Authorized redirect URI.
#
# Setting GMAIL_REFRESH_TOKEN below still WINS over anything connected from the
# tab, so a deliberately pinned token is never silently overridden. Leave it
# blank to manage the mailbox from the tab; the card says which one is in force.
GMAIL_REFRESH_TOKEN=
# Optional guards for the tab flow (the site has no login, so the start URL is
# public). GMAIL_ALLOWED_ACCOUNTS lists the addresses allowed to connect; unset
# means the FIRST mailbox connected is pinned and no other can replace it.
# GMAIL_ADMIN_SECRET, when set, is required as ?key= on connect/disconnect.
# GMAIL_TOKEN_KEY is the passphrase the stored token is sealed with (unset =
# derived from FIREBASE_SA; rotating either one just means reconnecting).
GMAIL_ALLOWED_ACCOUNTS=
GMAIL_ADMIN_SECRET=
GMAIL_TOKEN_KEY=
GMAIL_OAUTH_REDIRECT_URI=
# Optional. GMAIL_USER defaults to 'me' (the token's own account). GMAIL_QUERY is
# only a cheap PREFILTER to keep the message list short — deliberately NOT a
# sender/subject match, because the real test is whether the PDF parses as the
# freight report. Widen it if the report is ever archived before the poll runs.
GMAIL_USER=me
GMAIL_QUERY=has:attachment filename:pdf newer_than:7d
GMAIL_MAX_RESULTS=20

# Optional: vector Map ID for 3D tilt/rotate (hold Cmd/Ctrl + drag to spin).
# Create in Google Cloud Console > Maps > Map Management (rendering: Vector).
VITE_GOOGLE_MAP_ID=

# ── THE LOGIN — THREE SWITCHES, AND THEY GO IN THIS ORDER ────────────────────
#
# There is ONE login: usernames and passwords in Firestore `app_users`, verified by the
# Netlify Functions (netlify/functions/auth-*.mts). Three switches turn it on, and flipping
# them out of order is the way to lock the dispatch floor out of a 700-stop morning:
#
#   1. VITE_LOGIN_ENABLED  (BUILD-time, below)   put the login screen up
#   2. every account exists and has signed in once   (auth-bootstrap → auth-admin)
#   3. AUTH_REQUIRED       (RUNTIME, next section) start refusing un-signed-in callers
#
# BUILD-TIME vs RUNTIME IS NOT A DETAIL. Anything named VITE_* is baked into the JS bundle
# by Vite at BUILD time: changing it in the Netlify UI does NOTHING until the site is
# REDEPLOYED. AUTH_SESSION_SECRET and AUTH_REQUIRED are read by the functions at RUNTIME and
# take effect on the next request. So a rollback of step 3 is instant; a rollback of step 1
# needs a deploy, which is why step 1 is the one to be careful with.
#
# THE TRAP, NAMED: setting AUTH_REQUIRED=true while this build has no VITE_LOGIN_ENABLED
# makes every function answer 401 while the app still renders the board — a screen that
# looks normal and answers nothing, with no login offered, because the login screen is not
# in the bundle. The app now detects exactly that on boot (it reads `authRequired` back from
# auth-me) and says so instead of rendering the dead board — but do not rely on the safety
# net: set VITE_LOGIN_ENABLED and REDEPLOY first.
#
# VITE_LOGIN_ENABLED — the gate. UNSET or '' means the app renders exactly as it always has:
# no login screen, no session, nothing subscribed. Set to 1/true/on/yes ONLY after every
# account exists and has signed in once, and only in a quiet window. Needs a REDEPLOY.
VITE_LOGIN_ENABLED=

# VITE_AUTH_ENABLED — RETIRED (was the v0.76.0 Firebase email/password gate, lib/auth.js).
# It no longer gates anything. Its Firebase ID token parses as our session-token shape and
# then fails the HMAC compare, so requireUser() answers 401 even with AUTH_REQUIRED unset —
# signing into it could only ever produce a screen that says you are in and a board that
# behaves as if you are not.
#
# SETTING IT ALONE DOES NOT PUT UP A LOGIN, DELIBERATELY. It was written for a FIREBASE
# account list; the app_users accounts are separate and are created one at a time. On a site
# where they do not exist yet, honouring this flag would hand the whole floor a password box
# nobody has a password for, at 6am, curable only by a redeploy. So the app renders as
# normal and shows a warning bar saying the login was NOT switched on. Use
# VITE_LOGIN_ENABLED above; then delete this line.
VITE_AUTH_ENABLED=

# VITE_AUTH_ALLOWED_EMAILS — DEAD with the flag above. It only ever restricted the Firebase
# GOOGLE sign-in (signInWithGoogle in lib/auth.js), which now has zero callers, so this
# stops nothing and must NOT be read as the control that keeps a stranger out. Under the
# current login there are no self-service accounts to restrict: an admin creates every
# app_users account deliberately, which is the control. Left here only so a site that still
# has it set knows it is inert. Delete it.
VITE_AUTH_ALLOWED_EMAILS=

# ── USER ACCOUNTS (usernames + passwords, server-side) ────────────────────────
# The dispatch-map user system (netlify/functions/auth-*.mts, lib/require-user.mts).
# Accounts live in Firestore `app_users` (server-only; the rules file denies the browser).
#
# AUTH_SESSION_SECRET — 32+ random chars. Signs session tokens. UNSET ⇒ nobody can sign
#   in (fails closed). Rotating it signs everyone out.
# AUTH_REQUIRED — the enforcement switch. UNSET/false ⇒ every function behaves exactly as
#   before (a request with no token is the pre-login "everyone"); a request that carries
#   a token is still checked. Set to true ONLY after every dispatcher has an account and
#   has signed in once — the same order as the Firestore cutover.
# AUTH_BOOTSTRAP_SECRET — set ONCE to create the first admin via auth-bootstrap, then
#   remove it. The endpoint refuses once any active admin exists, so a forgotten value is
#   not a back door — but do not leave it.
# AUTH_SESSION_DAYS — session lifetime, 1–90 (default 14).
# AUTH_APP_URL — origin used in reset-link emails (default COMMS_SITE_ORIGIN / the prod site).
AUTH_SESSION_SECRET=
AUTH_REQUIRED=false
AUTH_BOOTSTRAP_SECRET=
AUTH_SESSION_DAYS=14
AUTH_APP_URL=

# --- Uline forecast: the monthly "DA - G - Uline Forecast" spreadsheet vs the nightly manifest ---
# Read out of the SAME Gmail grant as the manifest (Connect Gmail on the Manifest check tab).
# ULINE_FORECAST_QUERY   — the mailbox search; default subject:"Uline Forecast" has:attachment newer_than:45d.
#   A prefilter only: the parse decides what is a forecast.
# ULINE_FORECAST_CAPACITY — orders per DELIVERY day at which a route is added or freight is handed to
#   a carrier. Unset = no HEAVY / could-be-over chips at all (a guessed number would cry wolf).
# ULINE_ROUTE_DAY_ORDERS — one driver's day in orders (default 35). A night this far over the
#   estimate is "heavy"; a weekly revision this large is worth a change note.
ULINE_FORECAST_QUERY=
ULINE_FORECAST_CAPACITY=
ULINE_ROUTE_DAY_ORDERS=
# ULINE_DAVIS_CLOSED — days Davis runs NO routes beyond the federal holidays Uline also closes on
#   (those are inferred: a weekday absent from Uline's file that is also a federal holiday).
#   ISO dates, comma-separated, e.g. 2026-12-24 if Davis takes Christmas Eve. Uline not shipping
#   on a day does NOT stop Davis delivering the day before's freight on it — only this list does.
ULINE_DAVIS_CLOSED=
