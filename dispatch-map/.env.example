# Firebase (client-side — reuse the davismarginiq project config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=davismarginiq.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=davismarginiq
VITE_FIREBASE_STORAGE_BUCKET=davismarginiq.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API key (client-side — restrict by HTTP referrer in GCP console)
VITE_GOOGLE_MAPS_API_KEY=

# Mock-mode toggle — when true the app loads /test/fixtures/nuvizz-today-stops.json
# instead of calling the Netlify function. Useful for local dev without NuVizz creds.
VITE_USE_MOCK_NUVIZZ=false

# --- Server-side (Netlify Functions only — never prefix VITE_) ---
NUVIZZ_DAVIS_COMPANY_CODE=DAVIS
NUVIZZ_DAVIS_USER=
NUVIZZ_DAVIS_PASS=
NUVIZZ_BASE_URL=https://portal.nuvizz.com/deliverit/openapi/v7

# Motive API (server-side only)
MOTIVE_API_KEY=__REDACTED__
MOTIVE_BASE_URL=https://api.gomotive.com/v1

# Anthropic API key — powers M6 AI Order Search (ai-search function) and the
# routing brain (anthropic-routing). Server-side only; NEVER prefix with VITE_.
# Optional model overrides: ANTHROPIC_PARSE_MODEL, ANTHROPIC_CHAT_MODEL.
ANTHROPIC_API_KEY=

# Optional: vector Map ID for 3D tilt/rotate (hold Cmd/Ctrl + drag to spin).
# Create in Google Cloud Console > Maps > Map Management (rendering: Vector).
VITE_GOOGLE_MAP_ID=
