# Firebase (client-side — reuse the davismarginiq project config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=davismarginiq.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=davismarginiq
VITE_FIREBASE_STORAGE_BUCKET=davismarginiq.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API key (client-side — restrict by HTTP referrer in GCP console)
VITE_GOOGLE_MAPS_API_KEY=

# Mock-mode toggle — when true the app loads /test/fixtures/nuvizz-today-stops.json
# instead of calling the Netlify function. Useful for local dev without NuVizz creds.
VITE_USE_MOCK_NUVIZZ=false

# --- Server-side (Netlify Functions only — never prefix VITE_) ---
NUVIZZ_DAVIS_COMPANY_CODE=DAVIS
NUVIZZ_DAVIS_USER=
NUVIZZ_DAVIS_PASS=
NUVIZZ_BASE_URL=https://portal.nuvizz.com/deliverit/openapi/v7

# --- Live-write (BETA) — server-side kill switch for the nuvizz-write endpoint ---
# Master gate for REAL NuVizz writes (driver assign / dispatch / plan / unplan / create).
# Default OFF: with this unset/!=true, every mutating op returns 403 and NOTHING is sent
# to NuVizz — the UI's Beta/Live toggle still previews (dry-run) but cannot commit. Set to
# 'true' ONLY after confirming NUVIZZ_DAVIS_USER above is permitted to assign/dispatch in
# NuVizz (not just read). Reuses the read creds + base URL above.
NUVIZZ_WRITE_ENABLED=false

# Client-side opt-in to SHOW the live-dispatch UI in the Compare panel (default hidden).
# Showing the UI does NOT enable writes (that's NUVIZZ_WRITE_ENABLED above); it only
# surfaces the driver picker / Save / Beta-Live toggle. Per-session override: ?write=1.
VITE_NUVIZZ_WRITE_BETA=false

# Motive API (server-side only)
MOTIVE_API_KEY=__REDACTED__
MOTIVE_BASE_URL=https://api.gomotive.com/v1

# Anthropic API key — powers M6 AI Order Search (ai-search function) and the
# routing brain (anthropic-routing). Server-side only; NEVER prefix with VITE_.
# Optional model overrides: ANTHROPIC_PARSE_MODEL, ANTHROPIC_CHAT_MODEL.
ANTHROPIC_API_KEY=

# --- Gmail: read the nightly Uline freight report out of a Google mailbox ---
# The scheduled manifest check (manifest-email-ingest-background) polls every
# mailbox that is configured. Set ALL THREE of these to switch Gmail on; leave any
# of them blank and the Gmail half no-ops silently (Resend, below, is unaffected).
#
# ⚠ READ THIS FIRST — THE 7-DAY TRAP. An External OAuth app whose publishing
# status is still "Testing" is issued refresh tokens that expire after 7 DAYS.
# The check would work for a week, then quietly stop with invalid_grant. So the
# consent screen MUST be either:
#   • User type INTERNAL — if the mailbox is a Google Workspace account on our own
#     domain. No verification, no expiry, nothing to publish. Do this if you can.
#   • or External with publishing status IN PRODUCTION — needed for an @gmail.com
#     mailbox, since Internal is not offered there. Publish it; you can ignore the
#     "unverified app" warning for our own single account.
# Leaving it External + Testing is the one configuration that looks fine on day
# one and is broken by the following Monday.
#
# ONE-TIME SETUP:
#   1. GCP console > APIs & Services > enable the Gmail API on the project.
#   2. OAuth consent screen > set User type / publishing status per the note above.
#   3. Credentials > Create > OAuth client ID > WEB APPLICATION, with the
#      authorized redirect URI https://developers.google.com/oauthplayground
#      (Desktop app no longer works — Google killed the out-of-band flow in 2022).
#   4. Mint a refresh token once at https://developers.google.com/oauthplayground:
#      gear icon > "Use your own OAuth credentials" > paste the client id/secret,
#      Access type OFFLINE, tick "Force prompt consent screen"; scope
#      https://www.googleapis.com/auth/gmail.readonly; Authorize, SIGNED IN AS THE
#      MAILBOX THAT RECEIVES THE REPORT; then "Exchange authorization code for
#      tokens" and copy the refresh token.
#   5. Put the three values here / in the Netlify env. Read-only scope: the app
#      never sends, labels, or deletes.
# Google also drops a refresh token that has gone 6 months unused, and on a
# password change. When it does expire the job logs "gmail auth failed:
# invalid_grant" and keeps reading the other mailbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# ── v0.54.75: steps 3-5 above are now OPTIONAL ───────────────────────────────
# With CLIENT_ID + CLIENT_SECRET set, "Connect Gmail" on the Manifest check tab
# does the consent round-trip in the app and seals the refresh token in Firestore
# (AES-256-GCM, server-only key) — no playground, and RECONNECTING after the
# 7-day expiry above is one click instead of a re-mint. Register this site's
# https://<site>/.netlify/functions/gmail-auth as an Authorized redirect URI.
#
# Setting GMAIL_REFRESH_TOKEN below still WINS over anything connected from the
# tab, so a deliberately pinned token is never silently overridden. Leave it
# blank to manage the mailbox from the tab; the card says which one is in force.
GMAIL_REFRESH_TOKEN=
# Optional guards for the tab flow (the site has no login, so the start URL is
# public). GMAIL_ALLOWED_ACCOUNTS lists the addresses allowed to connect; unset
# means the FIRST mailbox connected is pinned and no other can replace it.
# GMAIL_ADMIN_SECRET, when set, is required as ?key= on connect/disconnect.
# GMAIL_TOKEN_KEY is the passphrase the stored token is sealed with (unset =
# derived from FIREBASE_SA; rotating either one just means reconnecting).
GMAIL_ALLOWED_ACCOUNTS=
GMAIL_ADMIN_SECRET=
GMAIL_TOKEN_KEY=
GMAIL_OAUTH_REDIRECT_URI=
# Optional. GMAIL_USER defaults to 'me' (the token's own account). GMAIL_QUERY is
# only a cheap PREFILTER to keep the message list short — deliberately NOT a
# sender/subject match, because the real test is whether the PDF parses as the
# freight report. Widen it if the report is ever archived before the poll runs.
GMAIL_USER=me
GMAIL_QUERY=has:attachment filename:pdf newer_than:7d
GMAIL_MAX_RESULTS=20

# Optional: vector Map ID for 3D tilt/rotate (hold Cmd/Ctrl + drag to spin).
# Create in Google Cloud Console > Maps > Map Management (rendering: Vector).
VITE_GOOGLE_MAP_ID=

# ── LOGIN (Phase 1 — ships SWITCHED OFF) ─────────────────────────────────────
# VITE_AUTH_ENABLED gates the whole login layer. UNSET or '' means the app renders
# exactly as it always has: no login screen, no firebase/auth import, nothing
# subscribed. Set to 1/true/on ONLY after every account exists and has signed in
# once — this is the one change in the security plan that can lock a dispatcher out
# of a 700-stop morning, so it is flipped deliberately, in a quiet window.
#
# ORDER MATTERS: turn this on and confirm sign-in works BEFORE tightening
# firestore.rules. The rules can only check request.auth once the browser actually
# signs in; tightening first breaks every note save, silently (several onSnapshot
# handlers swallow permission errors and just show stale data).
VITE_AUTH_ENABLED=

# Optional allow-list for GOOGLE sign-in only. Google will authenticate ANY Google
# account on earth, so without this a stranger becomes a signed-in user — and once
# the rules trust request.auth, "signed in" is what an attacker needs. Comma
# separated; accepts whole addresses and @domain suffixes. A subdomain is NOT the
# domain (see test/auth-gate.test.mjs). Empty = no restriction, which is correct for
# email/password because an admin created those accounts deliberately.
VITE_AUTH_ALLOWED_EMAILS=
