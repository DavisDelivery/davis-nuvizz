node_modules/
# ...and the SYMLINK form. "node_modules/" only matches a directory, so a `ln -s <main>/node_modules
# node_modules` made to share one install across a worktree is NOT ignored: `git add -A` swept one
# into a commit, it merged to main (#1064), and the next merge into a real checkout replaced that
# checkout's installed node_modules with the dangling link. A bare name matches both.
node_modules
dist/
# Any throwaway comparison build (dist-base, dist-old): build output is never
# committed, and one that was swept in by `git add -A` tripped Netlify's secret
# scanner and failed a deploy preview.
dist-*/
.netlify/
.DS_Store
*.log
.env
.env.local
artifacts/

# screenshot the hide-labels guard writes for a human to look at; never a build input
hide-place-labels-check.png
